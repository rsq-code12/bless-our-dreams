# Passcode for the couple's dashboard at /admin (6+ characters).
ADMIN_PASSCODE=

# Storage for contributions in production (Upstash Redis, e.g. from the Vercel Marketplace).
# Leave empty locally to use data/contributions.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public address of the site (only needed when NOT hosting on Vercel), e.g. https://ananya-rohan.in
SITE_URL=
